cat("\nП.7 ИССЛЕДОВАНИЕ КВАНТИЛЕЙ И VaR:\n")
mu_test <- seq(0.5, 3, by = 0.25)
var_ts_vals <- sapply(mu_test, function(m) {
quantile(rtweedie(5000, power = p_ts, mu = m, phi = phi_ts), 0.95, na.rm = TRUE)
})
par(mfrow = c(1, 2))
plot(mu_test, var_ts_vals, type = "b", col = "green", lwd = 2, pch = 16,
main = "Зависимость VaR(95%) от параметра μ",
xlab = "Параметр μ", ylab = "VaR (95%)")
grid()
# Эмпирическое распределение квантилей
ts_quantiles <- quantile(sample_ts, probs = c(0.5, 0.75, 0.9, 0.95, 0.99))
barplot(ts_quantiles,
main = "Квантили TS распределения",
xlab = "Уровень квантиля", ylab = "Значение",
col = "lightgreen", border = "darkgreen")
grid()
par(mfrow = c(1, 1))
cat("  Графики построены.\n")
cat("  VaR(95%) при μ =", mu_ts, ":",
quantile(sample_ts, 0.95), "\n")
cat("  VaR(99%) при μ =", mu_ts, ":",
quantile(sample_ts, 0.99), "\n\n")
# ----------------------------------------------------------------------------
# П.8: Вычисление семиинвариантов
# ----------------------------------------------------------------------------
cat("П.8 ВЫЧИСЛЕНИЕ СЕМИИНВАРИАНТОВ:\n")
# Теоретические семиинварианты для Tweedie распределения
k1_ts <- mu_ts
k2_ts <- phi_ts * (mu_ts^p_ts)
k3_ts <- (phi_ts^2) * p_ts * (mu_ts^(2*p_ts - 1))
k4_ts <- (phi_ts^3) * p_ts * (2*p_ts - 1) * (mu_ts^(3*p_ts - 2))
cat("    Теоретические семиинварианты (при заданных параметрах):\n")
cat("    κ₁ (математическое ожидание) =", k1_ts, "\n")
cat("    κ₂ (дисперсия) =", k2_ts, "\n")
cat("    κ₃ =", k3_ts, "\n")
cat("    κ₄ =", k4_ts, "\n\n")
cat("    Коэффициент асимметрии: γ₁ =", k3_ts / (k2_ts^1.5), "\n")
cat("    Коэффициент эксцесса: γ₂ =", k4_ts / (k2_ts^2), "\n")
cat("\n    Эмпирические оценки по выборке:\n")
cat("    Выборочное среднее =", mean(sample_ts), "\n")
cat("    Выборочная дисперсия =", var(sample_ts), "\n")
cat("    Выборочная асимметрия =",
mean((sample_ts - mean(sample_ts))^3) / (sd(sample_ts)^3), "\n")
cat("    Выборочный эксцесс =",
mean((sample_ts - mean(sample_ts))^4) / (var(sample_ts)^2) - 3, "\n")
# ============================================================================
# ЗАДАНИЕ 3: УСТОЙЧИВОЕ РАСПРЕДЕЛЕНИЕ
# ============================================================================
cat("\n", paste(rep("=", 50), collapse = ""), "\n")
cat("ЗАДАНИЕ 3: УСТОЙЧИВОЕ РАСПРЕДЕЛЕНИЕ S_α(σ, β, μ)\n")
cat(paste(rep("=", 50), collapse = ""), "\n\n")
cat("    Параметры: α ∈ (0,2] - индекс устойчивости\n")
cat("               β ∈ [-1,1] - параметр асимметрии\n")
cat("               σ > 0 - масштабный параметр\n")
cat("               μ ∈ R - параметр сдвига\n\n")
# Параметры устойчивого распределения
alpha_st <- 1.5
beta_st <- 0.5
gamma_st <- 1  # σ в нотации пакета
delta_st <- 0  # μ в нотации пакета
# ----------------------------------------------------------------------------
# П.1: Определения
# ----------------------------------------------------------------------------
cat("П.1 ОПРЕДЕЛЕНИЯ:\n")
cat("    Плотность не имеет аналитического выражения в общем случае\n")
cat("    Характеристическая функция (для α ≠ 1):\n")
cat("    φ(t) = exp(iδt - |σt|^α (1 - iβ sign(t) tan(πα/2)))\n\n")
# ----------------------------------------------------------------------------
# П.2: Исследование параметра alpha
# ----------------------------------------------------------------------------
cat("П.2 ИССЛЕДОВАНИЕ ПАРАМЕТРА α НА ГРАФИКАХ:\n")
cat("    Фиксируем β = 0.5, σ = 1, δ = 0, изменяем α = 1.2, 1.5, 1.8\n\n")
x_st_seq <- seq(-5, 5, length.out = 200)
df_st_theory <- data.frame(
x = rep(x_st_seq, 3),
alpha = as.factor(rep(c(1.2, 1.5, 1.8), each = 200)),
pdf = c(dstable(x_st_seq, 1.2, beta_st, gamma_st, delta_st),
dstable(x_st_seq, 1.5, beta_st, gamma_st, delta_st),
dstable(x_st_seq, 1.8, beta_st, gamma_st, delta_st)),
cdf = c(pstable(x_st_seq, 1.2, beta_st, gamma_st, delta_st),
pstable(x_st_seq, 1.5, beta_st, gamma_st, delta_st),
pstable(x_st_seq, 1.8, beta_st, gamma_st, delta_st))
)
p5 <- ggplot(df_st_theory, aes(x = x, y = pdf, color = alpha)) +
geom_line(linewidth = 1) +
labs(title = "Плотность устойчивого распределения",
subtitle = "Влияние параметра α (индекс устойчивости)",
x = "x", y = "f(x)", color = "α") +
theme_minimal() +
annotate("text", x = -4, y = 0.4, hjust = 0,
label = "С ростом α:\n• Тяжесть хвостов уменьшается\n• Пик становится выше\n• Распределение ближе к нормальному")
p6 <- ggplot(df_st_theory, aes(x = x, y = cdf, color = alpha)) +
geom_line(linewidth = 1) +
labs(title = "CDF устойчивого распределения",
subtitle = "Влияние параметра α",
x = "x", y = "F(x)", color = "α") +
theme_minimal()
grid.arrange(p5, p6, ncol = 2)
cat("  Графики построены. Нажмите Enter для продолжения...")
invisible(readline())
# ----------------------------------------------------------------------------
# П.3: Моделирование и точность
# ----------------------------------------------------------------------------
cat("\nП.3 МОДЕЛИРОВАНИЕ СЛУЧАЙНЫХ ВЕЛИЧИН:\n")
cat("    Алгоритм: Метод Чемберса-Мэллока для устойчивых распределений\n")
sample_st <- rstable(1000, alpha_st, beta_st, gamma_st, delta_st)
cat("    Сгенерировано 1000 значений\n")
# Точность моделирования - KS тест
ks_st <- ks.test(sample_st, "pstable", alpha = alpha_st,
beta = beta_st, gamma = gamma_st, delta = delta_st)
cat("\n    Критерий Колмогорова-Смирнова:\n")
cat("    Статистика D =", ks_st$statistic, "\n")
cat("    p-value =", ks_st$p.value, "\n")
cat("    ", ifelse(ks_st$p.value > 0.05, "✓", "✗"),
" Выборка соответствует теоретическому распределению (α=0.05)\n\n")
# ----------------------------------------------------------------------------
# П.4: Оценка параметров
# ----------------------------------------------------------------------------
cat("П.4 ОЦЕНКА ПАРАМЕТРОВ РАСПРЕДЕЛЕНИЯ:\n")
cat("    Метод максимального правдоподобия (MLE):\n")
fit_st <- stableFit(sample_st, type = "mle", doplot = FALSE)
cat("    Истинные значения:\n")
cat("    α =", alpha_st, ", β =", beta_st,
", σ =", gamma_st, ", δ =", delta_st, "\n\n")
cat("    Оценки параметров:\n")
print(fit_st@fit$estimate)
cat("\n    Стандартные ошибки:\n")
print(fit_st@fit$sd)
# ----------------------------------------------------------------------------
# П.5-6: Оценка плотности и визуализация
# ----------------------------------------------------------------------------
cat("\nП.5-6 ОЦЕНКА ПЛОТНОСТИ И СРАВНЕНИЕ:\n")
df_st_samp <- data.frame(val = sample_st)
plot_comb_st <- ggplot(df_st_samp, aes(x = val)) +
geom_histogram(aes(y = after_stat(density)), bins = 50,
fill = "orange", color = "black", alpha = 0.6) +
geom_density(aes(color = "Эмпирическая оценка"),
linewidth = 1, linetype = "dashed") +
stat_function(fun = dstable,
args = list(alpha = alpha_st, beta = beta_st,
gamma = gamma_st, delta = delta_st),
aes(color = "Истинная плотность"),
linewidth = 1) +
stat_function(fun = dstable,
args = list(alpha = fit_st@fit$estimate["alpha"],
beta = fit_st@fit$estimate["beta"],
gamma = fit_st@fit$estimate["gamma"],
delta = fit_st@fit$estimate["delta"]),
aes(color = "Теоретическая плотность (оценка)"),
linewidth = 0.8, linetype = "dotted") +
scale_color_manual(values = c("Эмпирическая оценка" = "red",
"Истинная плотность" = "purple",
"Теоретическая плотность (оценка)" = "blue")) +
coord_cartesian(xlim = c(-5, 5)) +
labs(title = "Сравнение гистограммы и плотностей устойчивого распределения",
subtitle = paste0("α = ", alpha_st, ", β = ", beta_st,
", σ = ", gamma_st, ", δ = ", delta_st),
x = "x", y = "Плотность", color = "Тип линии") +
theme_minimal() +
theme(legend.position = "bottom")
print(plot_comb_st)
cat("  График построен. Нажмите Enter для продолжения...")
invisible(readline())
# ----------------------------------------------------------------------------
# П.7: Исследование квантилей и VaR
# ----------------------------------------------------------------------------
cat("\nП.7 ИССЛЕДОВАНИЕ КВАНТИЛЕЙ И VaR:\n")
alphas_st_test <- seq(1.1, 1.9, by = 0.1)
var_st_vals <- sapply(alphas_st_test, function(a) {
qstable(0.95, alpha = a, beta = beta_st,
gamma = gamma_st, delta = delta_st)
})
par(mfrow = c(1, 2))
plot(alphas_st_test, var_st_vals, type = "b", col = "purple", lwd = 2, pch = 16,
main = "Зависимость VaR(95%) от α",
xlab = "Параметр α", ylab = "VaR (95%)")
grid()
# Исследование влияния β на квантили
betas_test <- seq(-0.9, 0.9, by = 0.3)
var_beta_vals <- sapply(betas_test, function(b) {
qstable(0.95, alpha = alpha_st, beta = b,
gamma = gamma_st, delta = delta_st)
})
plot(betas_test, var_beta_vals, type = "b", col = "darkred", lwd = 2, pch = 16,
main = "Зависимость VaR(95%) от β",
xlab = "Параметр β", ylab = "VaR (95%)")
grid()
par(mfrow = c(1, 1))
cat("  Графики построены.\n")
cat("  VaR(95%) при заданных параметрах:",
qstable(0.95, alpha = alpha_st, beta = beta_st,
gamma = gamma_st, delta = delta_st), "\n")
cat("  VaR(99%):",
qstable(0.99, alpha = alpha_st, beta = beta_st,
gamma = gamma_st, delta = delta_st), "\n\n")
# ----------------------------------------------------------------------------
# П.8: Вычисление семиинвариантов
# ----------------------------------------------------------------------------
cat("П.8 ВЫЧИСЛЕНИЕ СЕМИИНВАРИАНТОВ:\n")
cat("    ВАЖНОЕ ТЕОРЕТИЧЕСКОЕ ЗАМЕЧАНИЕ:\n")
cat("    Для устойчивых распределений с α < 2:\n")
cat("    • Второй семиинвариант (дисперсия) равен БЕСКОНЕЧНОСТИ\n")
cat("    • Семиинварианты третьего и четвертого порядка НЕ ОПРЕДЕЛЕНЫ\n")
cat("    • Производящая функция кумулянтов не имеет конечных моментов выше α\n\n")
cat("    Для α =", alpha_st, " (< 2):\n")
if(alpha_st > 1) {
cat("    κ₁ (математическое ожидание) =", delta_st, "\n")
} else {
cat("    κ₁ (математическое ожидание) = НЕ ОПРЕДЕЛЕНО (при α ≤ 1)\n")
}
cat("    κ₂ (дисперсия) = ∞\n")
cat("    κ₃, κ₄ = НЕ ОПРЕДЕЛЕНЫ\n\n")
cat("    Эмпирические оценки (для сравнения):\n")
cat("    Выборочное среднее =", mean(sample_st), "\n")
cat("    Выборочная дисперсия =", var(sample_st), "(конечная для выборки)\n")
cat("    Выборочная асимметрия =",
mean((sample_st - mean(sample_st))^3) / (sd(sample_st)^3), "\n")
cat("    Выборочный эксцесс =",
mean((sample_st - mean(sample_st))^4) / (var(sample_st)^2) - 3, "\n")
cat("\n    Эти оценки не имеют теоретического смысла,\n")
cat("    т.к. истинные моменты выше первого не существуют!\n")
# ============================================================================
# ИТОГОВЫЙ ВЫВОД
# ============================================================================
cat("\n", paste(rep("=", 50), collapse = ""), "\n")
cat("ИТОГИ ЛАБОРАТОРНОЙ РАБОТЫ\n")
cat(paste(rep("=", 50), collapse = ""), "\n\n")
cat("1. ЭКСПОНЕНЦИАЛЬНОЕ РАСПРЕДЕЛЕНИЕ:\n")
cat("   • Успешно смоделировано методом обратных функций\n")
cat("   • Параметр λ оценен методом MLE с точностью",
round(abs(lambda_est - lambda_true)/lambda_true * 100, 2), "%\n")
cat("   • Семиинварианты вычислены, подтверждены теоретические значения\n\n")
cat("2. TS (TEMPERED STABLE) РАСПРЕДЕЛЕНИЕ:\n")
cat("   • Смоделировано через пакет tweedie\n")
cat("   • Исследовано влияние параметров на форму распределения\n")
cat("   • Семиинварианты вычислены по теоретическим формулам\n\n")
cat("3. УСТОЙЧИВОЕ РАСПРЕДЕЛЕНИЕ:\n")
cat("   • Продемонстрирована особенность тяжелых хвостов (α < 2)\n")
cat("   • Показано, что дисперсия бесконечна в теории\n")
cat("   • Оценены параметры методом максимального правдоподобия\n")
cat("\n", paste(rep("=", 50), collapse = ""), "\n")
cat("РАБОТА ВЫПОЛНЕНА ПОЛНОСТЬЮ\n")
cat(paste(rep("=", 50), collapse = ""), "\n")
# Установка необходимых пакетов для лабораторной работы
install.packages(c(
"tidyverse",   # Для красивых графиков (ggplot2) и удобной работы с данными
"MASS",        # Для оценки параметров распределений (функция fitdistr)
"tweedie",     # Для работы с TS (Tweedie) распределением (вар. 7)
"stabledist",  # Для плотностей и функций устойчивого распределения (вар. 3)
"fBasics",     # Для оценки параметров устойчивого распределения (функция stableFit)
"gridExtra"    # Для объединения нескольких графиков на одной картинке
))
library(tidyverse)
library(tweedie)
library(stabledist)
library(gridExtra)
# ============================================================================
# 1. ЭКСПОНЕНЦИАЛЬНОЕ РАСПРЕДЕЛЕНИЕ (1 параметр: λ)
# ============================================================================
cat("Строим графики для Экспоненциального распределения...\n")
x_exp <- seq(0, 5, length.out = 200)
df_exp <- data.frame(
x = rep(x_exp, 3),
lambda = as.factor(rep(c(0.5, 1, 2), each = 200)),
pdf = c(dexp(x_exp, 0.5), dexp(x_exp, 1), dexp(x_exp, 2)),
cdf = c(pexp(x_exp, 0.5), pexp(x_exp, 1), pexp(x_exp, 2))
)
p1_exp <- ggplot(df_exp, aes(x = x, y = pdf, color = lambda)) + geom_line(linewidth = 1) +
labs(title = "Плотность (PDF)", subtitle = "Влияние параметра λ", x = "x", y = "f(x)") + theme_minimal()
p2_exp <- ggplot(df_exp, aes(x = x, y = cdf, color = lambda)) + geom_line(linewidth = 1) +
labs(title = "Функция распределения (CDF)", subtitle = "Влияние параметра λ", x = "x", y = "F(x)") + theme_minimal()
grid.arrange(p1_exp, p2_exp, ncol = 2)
# ============================================================================
# 2. TS (TWEEDIE) РАСПРЕДЕЛЕНИЕ (3 параметра: p, μ, φ)
# ============================================================================
cat("Строим графики для TS (Tweedie) распределения...\n")
# Безопасные функции вычисления (Tweedie иногда выдает ошибки на краях)
safe_dtweedie <- function(y, p, mu, phi) {
suppressWarnings(tryCatch(dtweedie(y = y, power = p, mu = mu, phi = phi), error = function(e) rep(NA, length(y))))
}
safe_ptweedie <- function(q, p, mu, phi) {
suppressWarnings(tryCatch(ptweedie(q = q, power = p, mu = mu, phi = phi), error = function(e) rep(NA, length(q))))
}
x_ts <- seq(0.01, 5, length.out = 200)
# --- 2.1 Влияние параметра p (power), фиксируем μ = 1, φ = 1 ---
df_ts_p <- data.frame(
x = rep(x_ts, 3),
p = as.factor(rep(c(1.2, 1.5, 1.8), each = 200)),
pdf = c(safe_dtweedie(x_ts, 1.2, 1, 1), safe_dtweedie(x_ts, 1.5, 1, 1), safe_dtweedie(x_ts, 1.8, 1, 1)),
cdf = c(safe_ptweedie(x_ts, 1.2, 1, 1), safe_ptweedie(x_ts, 1.5, 1, 1), safe_ptweedie(x_ts, 1.8, 1, 1))
)
plot_pdf_p <- ggplot(df_ts_p, aes(x=x, y=pdf, color=p)) + geom_line(linewidth=1, na.rm=TRUE) +
labs(title="Плотность (Tweedie)", subtitle="Изменяем p (μ=1, φ=1)", y="f(x)") + theme_minimal()
plot_cdf_p <- ggplot(df_ts_p, aes(x=x, y=cdf, color=p)) + geom_line(linewidth=1, na.rm=TRUE) +
labs(title="Функция распределения", subtitle="Изменяем p (μ=1, φ=1)", y="F(x)") + theme_minimal()
grid.arrange(plot_pdf_p, plot_cdf_p, ncol = 2)
# --- 2.2 Влияние параметра μ (mean), фиксируем p = 1.5, φ = 1 ---
df_ts_mu <- data.frame(
x = rep(x_ts, 3),
mu = as.factor(rep(c(0.5, 1, 2), each = 200)),
pdf = c(safe_dtweedie(x_ts, 1.5, 0.5, 1), safe_dtweedie(x_ts, 1.5, 1, 1), safe_dtweedie(x_ts, 1.5, 2, 1)),
cdf = c(safe_ptweedie(x_ts, 1.5, 0.5, 1), safe_ptweedie(x_ts, 1.5, 1, 1), safe_ptweedie(x_ts, 1.5, 2, 1))
)
plot_pdf_mu <- ggplot(df_ts_mu, aes(x=x, y=pdf, color=mu)) + geom_line(linewidth=1, na.rm=TRUE) +
labs(title="Плотность (Tweedie)", subtitle="Изменяем μ (p=1.5, φ=1)", y="f(x)") + theme_minimal()
plot_cdf_mu <- ggplot(df_ts_mu, aes(x=x, y=cdf, color=mu)) + geom_line(linewidth=1, na.rm=TRUE) +
labs(title="Функция распределения", subtitle="Изменяем μ (p=1.5, φ=1)", y="F(x)") + theme_minimal()
grid.arrange(plot_pdf_mu, plot_cdf_mu, ncol = 2)
# --- 2.3 Влияние параметра φ (phi), фиксируем p = 1.5, μ = 1 ---
df_ts_phi <- data.frame(
x = rep(x_ts, 3),
phi = as.factor(rep(c(0.5, 1, 2), each = 200)),
pdf = c(safe_dtweedie(x_ts, 1.5, 1, 0.5), safe_dtweedie(x_ts, 1.5, 1, 1), safe_dtweedie(x_ts, 1.5, 1, 2)),
cdf = c(safe_ptweedie(x_ts, 1.5, 1, 0.5), safe_ptweedie(x_ts, 1.5, 1, 1), safe_ptweedie(x_ts, 1.5, 1, 2))
)
plot_pdf_phi <- ggplot(df_ts_phi, aes(x=x, y=pdf, color=phi)) + geom_line(linewidth=1, na.rm=TRUE) +
labs(title="Плотность (Tweedie)", subtitle="Изменяем φ (p=1.5, μ=1)", y="f(x)") + theme_minimal()
plot_cdf_phi <- ggplot(df_ts_phi, aes(x=x, y=cdf, color=phi)) + geom_line(linewidth=1, na.rm=TRUE) +
labs(title="Функция распределения", subtitle="Изменяем φ (p=1.5, μ=1)", y="F(x)") + theme_minimal()
grid.arrange(plot_pdf_phi, plot_cdf_phi, ncol = 2)
# ============================================================================
# 3. УСТОЙЧИВОЕ РАСПРЕДЕЛЕНИЕ (4 параметра: α, β, σ, μ)
# ============================================================================
cat("Строим графики для Устойчивого распределения...\n")
x_st <- seq(-5, 5, length.out = 300)
# --- 3.1 Влияние параметра α (индекс стабильности), фикс: β=0.5, σ=1, μ=0 ---
df_st_alpha <- data.frame(
x = rep(x_st, 3),
alpha = as.factor(rep(c(1.2, 1.5, 2.0), each = 300)),
pdf = c(dstable(x_st, 1.2, 0.5, 1, 0), dstable(x_st, 1.5, 0.5, 1, 0), dstable(x_st, 2.0, 0.5, 1, 0)),
cdf = c(pstable(x_st, 1.2, 0.5, 1, 0), pstable(x_st, 1.5, 0.5, 1, 0), pstable(x_st, 2.0, 0.5, 1, 0))
)
plot_pdf_a <- ggplot(df_st_alpha, aes(x=x, y=pdf, color=alpha)) + geom_line(linewidth=1) +
labs(title="Плотность (Stable)", subtitle="Изменяем α (β=0.5, σ=1, μ=0)", y="f(x)") + theme_minimal()
plot_cdf_a <- ggplot(df_st_alpha, aes(x=x, y=cdf, color=alpha)) + geom_line(linewidth=1) +
labs(title="Функция распределения", subtitle="Изменяем α", y="F(x)") + theme_minimal()
grid.arrange(plot_pdf_a, plot_cdf_a, ncol = 2)
# --- 3.2 Влияние параметра β (асимметрия), фикс: α=1.5, σ=1, μ=0 ---
df_st_beta <- data.frame(
x = rep(x_st, 3),
beta = as.factor(rep(c(-0.5, 0, 0.5), each = 300)),
pdf = c(dstable(x_st, 1.5, -0.5, 1, 0), dstable(x_st, 1.5, 0, 1, 0), dstable(x_st, 1.5, 0.5, 1, 0)),
cdf = c(pstable(x_st, 1.5, -0.5, 1, 0), pstable(x_st, 1.5, 0, 1, 0), pstable(x_st, 1.5, 0.5, 1, 0))
)
plot_pdf_b <- ggplot(df_st_beta, aes(x=x, y=pdf, color=beta)) + geom_line(linewidth=1) +
labs(title="Плотность (Stable)", subtitle="Изменяем β (α=1.5, σ=1, μ=0)", y="f(x)") + theme_minimal()
plot_cdf_b <- ggplot(df_st_beta, aes(x=x, y=cdf, color=beta)) + geom_line(linewidth=1) +
labs(title="Функция распределения", subtitle="Изменяем β", y="F(x)") + theme_minimal()
grid.arrange(plot_pdf_b, plot_cdf_b, ncol = 2)
# --- 3.3 Влияние параметра σ (масштаб), фикс: α=1.5, β=0.5, μ=0 ---
df_st_sigma <- data.frame(
x = rep(x_st, 3),
sigma = as.factor(rep(c(0.5, 1, 2), each = 300)),
pdf = c(dstable(x_st, 1.5, 0.5, 0.5, 0), dstable(x_st, 1.5, 0.5, 1, 0), dstable(x_st, 1.5, 0.5, 2, 0)),
cdf = c(pstable(x_st, 1.5, 0.5, 0.5, 0), pstable(x_st, 1.5, 0.5, 1, 0), pstable(x_st, 1.5, 0.5, 2, 0))
)
plot_pdf_s <- ggplot(df_st_sigma, aes(x=x, y=pdf, color=sigma)) + geom_line(linewidth=1) +
labs(title="Плотность (Stable)", subtitle="Изменяем σ (α=1.5, β=0.5, μ=0)", y="f(x)") + theme_minimal()
plot_cdf_s <- ggplot(df_st_sigma, aes(x=x, y=cdf, color=sigma)) + geom_line(linewidth=1) +
labs(title="Функция распределения", subtitle="Изменяем σ", y="F(x)") + theme_minimal()
grid.arrange(plot_pdf_s, plot_cdf_s, ncol = 2)
# --- 3.4 Влияние параметра μ (сдвиг), фикс: α=1.5, β=0.5, σ=1 ---
df_st_mu <- data.frame(
x = rep(x_st, 3),
mu_loc = as.factor(rep(c(-2, 0, 2), each = 300)),
pdf = c(dstable(x_st, 1.5, 0.5, 1, -2), dstable(x_st, 1.5, 0.5, 1, 0), dstable(x_st, 1.5, 0.5, 1, 2)),
cdf = c(pstable(x_st, 1.5, 0.5, 1, -2), pstable(x_st, 1.5, 0.5, 1, 0), pstable(x_st, 1.5, 0.5, 1, 2))
)
plot_pdf_m <- ggplot(df_st_mu, aes(x=x, y=pdf, color=mu_loc)) + geom_line(linewidth=1) +
labs(title="Плотность (Stable)", subtitle="Изменяем μ сдвига (α=1.5, β=0.5, σ=1)", y="f(x)") + theme_minimal()
plot_cdf_m <- ggplot(df_st_mu, aes(x=x, y=cdf, color=mu_loc)) + geom_line(linewidth=1) +
labs(title="Функция распределения", subtitle="Изменяем μ сдвига", y="F(x)") + theme_minimal()
grid.arrange(plot_pdf_m, plot_cdf_m, ncol = 2)
# Если пакет tweedie не установлен, раскомментируйте строку ниже:
# install.packages("tweedie")
library(tweedie)
analyze_ts_residuals <- function(asset_name) {
filename <- paste0("resid_", asset_name, ".csv")
data <- read.csv(filename)
x <- data$resid
# 1. Сдвиг (TS / Tweedie определено для x > 0)
shift_val <- abs(min(x)) + 0.1
x_pos <- x + shift_val
# 2. Оценка параметров методом моментов (строго из прошлой лабораторной)
p_fixed <- 1.5
mu_hat <- mean(x_pos)
s2 <- var(x_pos)
phi_hat <- s2 / (mu_hat^p_fixed)
cat("=========================================\n")
cat("Анализ TS для актива:", asset_name, "\n")
cat("-----------------------------------------\n")
cat("Параметры TS (Метод моментов):\n")
cat("Сдвиг =", shift_val, "\n")
cat("p   =", p_fixed, "\n")
cat("mu  =", mu_hat, "\n")
cat("phi =", phi_hat, "\n")
# 3. Критерий Колмогорова-Смирнова
suppressWarnings({
ks_result <- ks.test(x_pos, "ptweedie", power=p_fixed, mu=mu_hat, phi=phi_hat)
})
cat("-----------------------------------------\n")
cat("Критерий Колмогорова-Смирнова:\n")
cat("Статистика D =", ks_result$statistic, "\n")
cat("p-value      =", ks_result$p.value, "\n")
cat("=========================================\n\n")
}
analyze_ts_residuals("ASML")
